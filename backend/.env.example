# Backend-only direct Supabase Postgres connection (migration, seed and API).
SUPABASE_DB_URL=postgresql://postgres:REPLACE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# IPv4-only runners may set the exact Session pooler host from Dashboard → Connect:
# SUPABASE_DB_POOLER_HOST=aws-0-YOUR_REGION.pooler.supabase.com

# Alternatively, use the Supabase Data API from the backend:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Legacy projects may use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# SUPABASE_DB_URL and secret/service-role keys must never enter browser/mobile code.

# Optional server-side LLM extraction. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
