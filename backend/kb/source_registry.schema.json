{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrisense.local/schemas/source-registry-v2.json",
  "title": "AgriSense source registry",
  "type": "object",
  "required": ["schema_version", "reviewed_at", "default_policy", "status_vocabulary", "sources"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "reviewed_at": {"type": "string", "format": "date"},
    "default_policy": {"type": "object"},
    "status_vocabulary": {
      "type": "object",
      "required": ["download_status", "curation_status", "safety_status"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "asset_type",
          "version",
          "accessed_at",
          "language",
          "geography",
          "topics",
          "download_status",
          "curation_status",
          "safety_status",
          "licence",
          "redistribution_allowed",
          "machine_readable",
          "update_check"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "publisher": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "asset_type": {"type": "string", "minLength": 1},
          "version": {"type": ["string", "number"]},
          "accessed_at": {"type": "string", "format": "date"},
          "language": {"type": "string", "minLength": 2},
          "geography": {"type": "string", "minLength": 1},
          "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "download_status": {
            "enum": ["downloaded", "live_api", "not_downloaded", "not_applicable"]
          },
          "curation_status": {
            "enum": [
              "curated_subset",
              "raw_only",
              "approved_for_curation",
              "requires_ocr",
              "requires_status_crosscheck",
              "reference_only"
            ]
          },
          "safety_status": {
            "enum": [
              "approved",
              "provisional",
              "blocked",
              "approved_with_quarantine",
              "licence_restricted"
            ]
          },
          "licence": {"type": "string", "minLength": 1},
          "redistribution_allowed": {"type": "boolean"},
          "machine_readable": {"enum": [true, false, "partial"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "pages": {"type": "integer", "minimum": 1},
          "selected_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"download_status": {"const": "downloaded"}},
              "required": ["download_status"]
            },
            "then": {
              "anyOf": [
                {"required": ["local_path", "sha256"]},
                {"required": ["selected_files"]}
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
